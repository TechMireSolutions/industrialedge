{
  "name": "industrial-edge-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Industrial Edge E-commerce Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node -e \"require('fs').copyFileSync('prisma/schema.local.prisma', 'prisma/schema.prisma')\" && dotenv -e .env.local -- tsx watch src/server.ts",
    "db:push:local": "dotenv -e .env.local -- prisma db push --schema=prisma/schema.local.prisma",
    "db:push:production": "prisma db push --schema=prisma/schema.prisma",
    "build": "node -e \"require('fs').copyFileSync('prisma/schema.local.prisma', 'prisma/schema.prisma')\" && prisma generate && npx tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.local.prisma",
    "prisma:studio": "dotenv -e .env.local -- prisma studio --schema=prisma/schema.local.prisma",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.3",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3",
    "typescript": "^5.5.4",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.19.0",
    "tsx": "^4.23.13"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true
  }
}
